{
  "version": 3,
  "note": "Panel library for focus-swarm. Sizes are defaults; the cast picker overrides them. Every persona is fictional unless the user explicitly turns on real-people research for a panel that allows it (can_cast_real_people).",
  "families": [
    {
      "id": "use",
      "label": "People who use it"
    },
    {
      "id": "spread",
      "label": "People who sell or spread it"
    },
    {
      "id": "decide",
      "label": "People who fund, buy or approve it"
    }
  ],
  "panels": [
    {
      "id": "general",
      "label": "Everyday users",
      "family": "use",
      "accent": "#6c7cff",
      "size": 10,
      "can_cast_real_people": false,
      "sees_brief": false,
      "min_hostile": 1,
      "min_skeptical": 3,
      "question": "Could I use this at all, and would I ever want to?",
      "spread": [
        "at least one person under 20 and two over 55, the rest spread across 25-54",
        "a tech-literacy ladder from 'asks their grandchild to install apps' to 'runs a home server', at least 2 on the bottom rung",
        "at least 3 on a phone, 1 on a poor connection, 1 with an accessibility need, 1 on an old device or browser",
        "at least 2 people for whom the price is a real decision",
        "a first-timer, someone dragged in by a partner or colleague, someone who arrived by mistake, someone who tried a competitor",
        "at least 2 people whose first language is not the product's language"
      ]
    },
    {
      "id": "commercial",
      "label": "Commercial users 16-49",
      "family": "use",
      "accent": "#14b8a6",
      "size": 10,
      "can_cast_real_people": false,
      "sees_brief": false,
      "min_hostile": 1,
      "min_skeptical": 3,
      "question": "Does this survive contact with my actual workflow, and what would I drop for it?",
      "spread": [
        "age strictly 16-49, at least one aged 16-19 and one aged 45-49",
        "everyone has a NAMED current tool to replace, including 'a spreadsheet' and 'I do it by hand'",
        "solo freelancer, small studio, agency employee, in-house at a large company, student with a side hustle, someone whose employer picks their tools",
        "at least 2 must justify the budget to somebody else",
        "at least 2 judge on speed, 2 on quality, 1 on legal terms and data ownership"
      ]
    },
    {
      "id": "research",
      "label": "Researchers",
      "family": "decide",
      "accent": "#a855f7",
      "size": 10,
      "can_cast_real_people": true,
      "sees_brief": true,
      "min_hostile": 1,
      "min_skeptical": 3,
      "question": "Is the claim true, is it new, and what breaks under scrutiny?",
      "spread": [
        "at least 3 from outside the product's home region",
        "at least three distinct disciplines relevant to the product",
        "at least 3 known critics of the category",
        "at least 1 who works on evaluation and measurement",
        "at least 1 from industry research rather than academia"
      ],
      "extra_block": {
        "key": "science",
        "label": "Scientific assessment",
        "schema_ref": "AgentReport.science"
